NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Prefer a Supabase secret key; the legacy service_role key is
# supported through SUPABASE_SERVICE_ROLE_KEY for existing deployments.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=

# Keep false while reviewing imported stakeholder data.
STAKEHOLDER_DUPLICATE_RESOLUTION_ENABLED=false

# Separate StakeMap deployment displayed inside the authenticated stakeholder
# workspace. Keep this as an HTTPS origin in deployed environments. When
# omitted, Vercel previews use the StakeMap deploy preview and production uses
# the production StakeMap deployment.
STAKEHOLDER_APP_URL=https://stakemapper.netlify.app

# Set to shared only when STAKEHOLDER_APP_URL points to a StakeMap deployment
# configured to use the To-do Tracker Supabase project. When omitted, Vercel
# deployments default to shared because the standard preview and production
# StakeMap URLs both use the migrated canonical register.
STAKEHOLDER_DATA_MODE=shared
